---
// Presentation deck. Edit the slides in src/slides.md, not here.
import slidesMarkdown from '../slides.md?raw';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/600.css';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <title>Slides | The Entry-Level Cybersecurity Paradox</title>
  </head>
  <body>
    <a class="back" href={base}>&lt; back to site</a>
    <div class="reveal">
      <div class="slides">
        <section data-markdown data-separator="^\r?\n---\r?\n$" data-separator-notes="^Note:">
          <textarea data-template>{slidesMarkdown}</textarea>
        </section>
      </div>
    </div>

    <script>
      import Reveal from 'reveal.js';
      import Markdown from 'reveal.js/plugin/markdown';
      import Notes from 'reveal.js/plugin/notes';
      import 'reveal.js/reset.css';
      import 'reveal.js/reveal.css';
      import 'reveal.js/theme/black.css';
      import '../styles/slides.css';

      const deck = new Reveal({ hash: true, slideNumber: 'c/t', plugins: [Markdown, Notes] });
      deck.initialize();
    </script>

  </body>
</html>
